<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Goosic.Windows.Views">

    <!--
        Chrome-free glyph buttons.

        WinUI's default Button paints a filled, bordered rectangle. A row of them reads as a
        toolbar of boxes rather than as transport controls, so these keep the hit target and the
        focus visual and drop the plate.
    -->
    <Style x:Key="TransportGlyphStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="TransportPlayStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Width" Value="40" />
    </Style>

    <Style x:Key="TransportToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- The round carousel arrows beside a shelf title, as YouTube Music draws them. -->
    <Style x:Key="ShelfArrowStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource GoosicRaisedStrongBrush}" />
    </Style>

    <!-- The full-screen player's controls: larger, and always light over the cover's colours. -->
    <Style x:Key="FullPlayerGlyphStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FullPlayerToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource TransportToggleStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ===== Settings, grouped the way iOS Settings groups them ===== -->

    <!-- A group: rounded, and holding its rows edge to edge, separated by thin inset lines. -->
    <Style x:Key="SettingsGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GoosicRaisedBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The small grey name above a group. -->
    <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource GoosicSecondaryTextBrush}" />
        <Setter Property="Margin" Value="16,18,0,6" />
    </Style>

    <!-- The note under a group. -->
    <Style x:Key="SettingsGroupFooterStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource GoosicSecondaryTextBrush}" />
        <Setter Property="Margin" Value="16,6,16,0" />
    </Style>

    <!-- The line between two rows starts after the icon, as iOS draws it. -->
    <Style x:Key="SettingsSeparatorStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="60,0,0,0" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- A switch with no words beside it; the row says what it does. -->
    <Style x:Key="SettingsSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,-12,0" />
    </Style>

    <Style TargetType="views:SettingsRow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SettingsRow">
                    <Grid MinHeight="56" Padding="14,8,16,8" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                                Background="{TemplateBinding Tile}">
                            <FontIcon Glyph="{TemplateBinding Glyph}" FontSize="16" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource GoosicSecondaryTextBrush}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar actions keep native input/focus behavior in both the rail and expanded panel. -->
    <Style x:Key="SidebarNavigationStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="SelectionFill" CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{ThemeResource GoosicSidebarSelectedBrush}" Opacity="0" />
                        <Border x:Name="InteractionFill" CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{ThemeResource GoosicRaisedStrongBrush}" Opacity="0" />
                        <ContentPresenter x:Name="NavigationContent" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="InteractionFill.Opacity" Value="0.65" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="InteractionFill.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="NavigationContent.Opacity" Value="0.4" /></VisualState.Setters>
                                </VisualState>
                                <!-- WinUI ToggleButton requests combined checked/interaction states. -->
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionFill.Opacity" Value="1" />

                                        <Setter Target="NavigationContent.Foreground" Value="{ThemeResource GoosicSidebarSelectedTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionFill.Opacity" Value="1" />

                                        <Setter Target="NavigationContent.Foreground" Value="{ThemeResource GoosicSidebarSelectedTextBrush}" />
                                        <Setter Target="InteractionFill.Opacity" Value="0.65" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionFill.Opacity" Value="1" />

                                        <Setter Target="NavigationContent.Foreground" Value="{ThemeResource GoosicSidebarSelectedTextBrush}" />
                                        <Setter Target="InteractionFill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionFill.Opacity" Value="1" />

                                        <Setter Target="NavigationContent.Foreground" Value="{ThemeResource GoosicSidebarSelectedTextBrush}" />
                                        <Setter Target="NavigationContent.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarRailItemStyle" TargetType="ToggleButton" BasedOn="{StaticResource SidebarNavigationStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SidebarItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="SidebarIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="14,16,0,4" />
        <Setter Property="Foreground" Value="{ThemeResource GoosicSecondaryTextBrush}" />
    </Style>

    <Style x:Key="SidebarGlyphStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- The round button at the top left that shows and hides the sidebar. -->
    <!-- A small flat square, like the macOS sidebar button: no disc sitting over the panel's edge. -->
    <Style x:Key="SidebarToggleStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Native buttons retain their gradient on hover; focus and activation remain native. -->
    <Style x:Key="SearchBrowseCardStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="1" BorderBrush="{ThemeResource GoosicPillBorderBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CardSurface.Opacity" Value="0.9" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CardSurface.Opacity" Value="0.75" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CardSurface.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== The floating player pill ===== -->
    <!-- A 32-pixel canvas around each glyph: the macOS player's 30, rounded up to Windows' grid. -->
    <Style x:Key="PillGlyphStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.78" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.55" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.32" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource TransportToggleStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <!-- What is switched on sits on a faint disc as well as taking the accent. -->
                        <Border x:Name="Plate" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"
                                Background="{ThemeResource GoosicRaisedStrongBrush}" />
                        <ContentPresenter x:Name="Presenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <!--
                            One group, because a toggle button asks for one state at a time and
                            names it for both things at once: "CheckedPointerOver", then "Normal".
                            Kept as two groups, nothing ever asked to leave "Checked", and a
                            button switched off again stayed drawn as on.
                        -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.78" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.32" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="Plate.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.78" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="Plate.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.55" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="Plate.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.32" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="Plate.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.78" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IndeterminatePressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IndeterminateDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.32" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin position line. The default slider's 32-pixel frame would not fit in the pill. -->
    <Style x:Key="PillProgressStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
    </Style>

    <!-- The volume popover: a tall rounded pill with the level, a vertical slider and mute. -->
    <Style x:Key="VolumeFlyoutStyle" TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="8,14,8,8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{ThemeResource GoosicPillAcrylicBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GoosicPillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="VolumeSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource GoosicAccentBrush}" />
    </Style>

    <!--
        A lyric line that seeks when clicked. It is only its text: a plate lighting up behind a
        line under the pointer would be the one thing on the page that is not lyrics.
    -->
    <Style x:Key="LyricLineButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,0,26" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Background="Transparent" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RailGlyphStyle" TargetType="Button" BasedOn="{StaticResource TransportGlyphStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RailRouteStyle" TargetType="Button" BasedOn="{StaticResource RailGlyphStyle}" />

    <!-- The account avatar: initials on the accent, as a circle. -->
    <Style x:Key="RailAvatarStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource GoosicAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SidebarRouteStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <!-- A track row is the whole width and carries no plate; the artwork is the affordance. -->
    <Style x:Key="TrackRowStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <!-- The artwork is the affordance, so the card carries no plate of its own. -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!--
        Menus, drawn closer to macOS's: a rounder panel, tighter rows, each row its own rounded
        highlight in Goosic's colour. The macOS shell's menus are the reference (the same items,
        names and order), so a song's menu reads as one product on both. The highlight colours
        live in App.xaml beside the slider's, since they replace system theme resources.
    -->
    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0,5" />
    </Style>

    <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="Padding" Value="10,5,12,6" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
        <Setter Property="Padding" Value="10,5,12,6" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

</ResourceDictionary>
