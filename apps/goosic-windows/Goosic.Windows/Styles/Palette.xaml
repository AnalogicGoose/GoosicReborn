<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="GoosicSearchExploreBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#326CB3" Offset="0" /><GradientStop Color="#008FFF" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="GoosicSearchChartsBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BD722F" Offset="0" /><GradientStop Color="#FF922A" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="GoosicSearchMoodsBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A92FB3" Offset="0" /><GradientStop Color="#D929EE" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="GoosicSearchReleasesBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B82E52" Offset="0" /><GradientStop Color="#FF2D61" Offset="1" /></LinearGradientBrush>
            <SolidColorBrush x:Key="GoosicSearchCardTextBrush" Color="White" />
            <SolidColorBrush x:Key="GoosicNavigationAccentBrush" Color="#FF0552" />
            <SolidColorBrush x:Key="GoosicSidebarSelectedTextBrush" Color="{ThemeResource SystemBaseHighColor}" />
            <SolidColorBrush x:Key="GoosicWindowBackgroundBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="GoosicRailBrush" Color="#211B30" />
            <SolidColorBrush x:Key="GoosicChromeBrush" Color="#1A1A20" />
            <SolidColorBrush x:Key="GoosicRaisedBrush" Color="#FFFFFF" Opacity="0.055" />
            <SolidColorBrush x:Key="GoosicRaisedStrongBrush" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="GoosicSecondaryTextBrush" Color="#9E9EA7" />
            <SolidColorBrush x:Key="GoosicHairlineBrush" Color="#FFFFFF" Opacity="0.09" />
            <!--
                Apple Music for Windows' dark greys, sampled from its window: a #1C1C1C page with
                #282828 cards. The sidebar keeps Goosic's own glass over the page, and floating bars
                sit a step lighter than the page so they read as raised.
            -->
            <AcrylicBrush x:Key="GoosicSidebarAcrylicBrush" TintColor="#252525" TintOpacity="0.78"
                          TintLuminosityOpacity="0.6" FallbackColor="#252525" />
            <AcrylicBrush x:Key="GoosicPillAcrylicBrush" TintColor="#333333" TintOpacity="0.6"
                          TintLuminosityOpacity="0.5" FallbackColor="#E6303030" />
            <AcrylicBrush x:Key="GoosicMenuAcrylicBrush" TintColor="#2C2C2C" TintOpacity="0.7"
                          TintLuminosityOpacity="0.7" FallbackColor="#F0282828" />
            <SolidColorBrush x:Key="GoosicPillBorderBrush" Color="#FFFFFF" Opacity="0.14" />
            <SolidColorBrush x:Key="GoosicSidebarSelectedBrush" Color="#FFFFFF" Opacity="0.10" />
            <!-- Fades the page out under the title bar, so scrolled titles never run into the window buttons. -->
            <LinearGradientBrush x:Key="GoosicTitleFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F51C1C1C" Offset="0" />
                <GradientStop Color="#E61C1C1C" Offset="0.6" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="GoosicSearchExploreBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#326CB3" Offset="0" /><GradientStop Color="#008FFF" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="GoosicSearchChartsBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BD722F" Offset="0" /><GradientStop Color="#FF922A" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="GoosicSearchMoodsBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A92FB3" Offset="0" /><GradientStop Color="#D929EE" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="GoosicSearchReleasesBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B82E52" Offset="0" /><GradientStop Color="#FF2D61" Offset="1" /></LinearGradientBrush>
            <SolidColorBrush x:Key="GoosicSearchCardTextBrush" Color="White" />
            <SolidColorBrush x:Key="GoosicNavigationAccentBrush" Color="#FF0552" />
            <SolidColorBrush x:Key="GoosicSidebarSelectedTextBrush" Color="{ThemeResource SystemBaseHighColor}" />
            <SolidColorBrush x:Key="GoosicWindowBackgroundBrush" Color="#FBFBFD" />
            <SolidColorBrush x:Key="GoosicRailBrush" Color="#F0EDF5" />
            <SolidColorBrush x:Key="GoosicChromeBrush" Color="#EDEDF2" />
            <SolidColorBrush x:Key="GoosicRaisedBrush" Color="#000000" Opacity="0.05" />
            <SolidColorBrush x:Key="GoosicRaisedStrongBrush" Color="#000000" Opacity="0.10" />
            <SolidColorBrush x:Key="GoosicSecondaryTextBrush" Color="#5C5C66" />
            <SolidColorBrush x:Key="GoosicHairlineBrush" Color="#000000" Opacity="0.12" />
            <AcrylicBrush x:Key="GoosicSidebarAcrylicBrush" TintColor="#F3F3F6" TintOpacity="0.55"
                          TintLuminosityOpacity="0.7" FallbackColor="#F1F1F5" />
            <AcrylicBrush x:Key="GoosicPillAcrylicBrush" TintColor="#FFFFFF" TintOpacity="0.45"
                          TintLuminosityOpacity="0.6" FallbackColor="#F2FFFFFF" />
            <AcrylicBrush x:Key="GoosicMenuAcrylicBrush" TintColor="#F3F3F6" TintOpacity="0.55"
                          TintLuminosityOpacity="0.7" FallbackColor="#F1F1F5" />
            <SolidColorBrush x:Key="GoosicPillBorderBrush" Color="#000000" Opacity="0.10" />
            <SolidColorBrush x:Key="GoosicSidebarSelectedBrush" Color="#000000" Opacity="0.08" />
            <!-- Fades the page out under the title bar, so scrolled titles never run into the window buttons. -->
            <LinearGradientBrush x:Key="GoosicTitleFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F5FBFBFD" Offset="0" />
                <GradientStop Color="#E6FBFBFD" Offset="0.6" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <!--
            Contrast themes: every surface takes the user's system colours, and translucent fills
            and acrylic give way to solid ones, which is what those themes promise to deliver.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GoosicSearchExploreBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicSearchChartsBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicSearchMoodsBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicSearchReleasesBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicSearchCardTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GoosicNavigationAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GoosicSidebarSelectedTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GoosicWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicTitleFadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicRaisedStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GoosicHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GoosicSidebarAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicPillAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicMenuAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GoosicPillBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GoosicSidebarSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        The shell's colours in one place, so a surface cannot drift from the rest.

        The accent is literal because the brand red has to be the same red whatever the desktop
        accent is set to. The neutrals are theme dictionaries rather than fixed values: a
        translucent white raises a surface on a dark ground and vanishes on a light one, so each
        neutral states both rather than suiting one scheme and being wrong in the other.
    -->
    <Color x:Key="GoosicAccentColor">#F53150</Color>
    <SolidColorBrush x:Key="GoosicAccentBrush" Color="{StaticResource GoosicAccentColor}" />



    <x:Double x:Key="GoosicTransportHeight">56</x:Double>
    <x:Double x:Key="GoosicCardSize">196</x:Double>

</ResourceDictionary>
