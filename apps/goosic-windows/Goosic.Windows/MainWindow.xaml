<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Goosic.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Goosic.Windows"
    xmlns:vm="using:Goosic.Windows.ViewModels"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource GoosicWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The transport is the title bar. Apple Music puts the controls on the same row as the
            window buttons rather than below them, so the window's content is extended into the
            caption area and this strip is handed to the system as the drag region.
        -->
        <Grid x:Name="TransportBar" Grid.Row="0" Background="{ThemeResource GoosicChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- Left clear for the system's minimise, maximise and close buttons. -->
                <ColumnDefinition Width="146" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Spacing="2" Margin="10,0,0,0">
                <ToggleButton x:Name="ShuffleButton" Style="{StaticResource TransportToggleStyle}"
                              Content="&#xE8B1;" IsChecked="{x:Bind Model.IsShuffled, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Model.ShuffleLabel, Mode=OneWay}"
                              AutomationProperties.Name="Shuffle" Click="OnShuffle" />
                <Button x:Name="PreviousButton" Style="{StaticResource TransportGlyphStyle}"
                        Content="&#xE892;" ToolTipService.ToolTip="Previous" Click="OnPrevious" />
                <Button x:Name="PlayButton" Style="{StaticResource TransportPlayStyle}"
                        Content="{x:Bind Model.PlayPauseGlyph, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Model.PlayPauseLabel, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Model.PlayPauseLabel, Mode=OneWay}"
                        Click="OnPlayPause" />
                <Button x:Name="NextButton" Style="{StaticResource TransportGlyphStyle}"
                        Content="&#xE893;" ToolTipService.ToolTip="Next" Click="OnNext" />
                <ToggleButton x:Name="RepeatButton" Style="{StaticResource TransportToggleStyle}"
                              Content="{x:Bind Model.RepeatGlyph, Mode=OneWay}"
                              IsChecked="{x:Bind Model.IsRepeating, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Model.RepeatLabel, Mode=OneWay}"
                              AutomationProperties.Name="Repeat" Click="OnRepeat" />
            </StackPanel>

            <!--
                The centre panel. Apple Music tints it from the playing artwork; until artwork
                colour extraction exists this is a flat raised surface, which is the same shape
                without pretending to a colour it has not sampled.
            -->
            <Border Grid.Column="2" MinWidth="420" MaxWidth="560" Height="44"
                    CornerRadius="6" Background="{ThemeResource GoosicRaisedBrush}"
                    VerticalAlignment="Center">
                <Grid Margin="6,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="3"
                            Background="{ThemeResource GoosicRaisedStrongBrush}">
                        <Image x:Name="NowPlayingArtwork" Source="{x:Bind Model.NowPlayingArtwork, Mode=OneWay}"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" Spacing="1">
                        <TextBlock x:Name="NowPlayingTitle" Text="{x:Bind Model.NowPlayingTitle, Mode=OneWay}"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="NowPlayingSubtitle" Text="{x:Bind Model.NowPlayingSubtitle, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                        <Slider x:Name="PlaybackProgress" Minimum="0" Height="6" StepFrequency="1"
                                Maximum="{x:Bind Model.PlaybackDuration, Mode=OneWay}"
                                Value="{x:Bind Model.PlaybackPosition, Mode=OneWay}"
                                IsEnabled="{x:Bind Model.IsSeekable, Mode=OneWay}"
                                AutomationProperties.Name="Position" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                        Spacing="2" Margin="0,0,8,0">
                <ToggleButton Style="{StaticResource TransportToggleStyle}" Content="&#xE8E1;"
                              Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}"
                              IsChecked="{x:Bind Model.IsNowPlayingLiked, Mode=OneWay}"
                              ToolTipService.ToolTip="Like" AutomationProperties.Name="Like"
                              Click="OnLikeNowPlaying" />
                <ToggleButton Style="{StaticResource TransportToggleStyle}" Content="&#xE8E0;"
                              Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}"
                              IsChecked="{x:Bind Model.IsNowPlayingDisliked, Mode=OneWay}"
                              ToolTipService.ToolTip="Dislike" AutomationProperties.Name="Dislike"
                              Click="OnDislikeNowPlaying" />
                <Button x:Name="VolumeButton" Style="{StaticResource TransportGlyphStyle}"
                        Content="{x:Bind Model.VolumeGlyph, Mode=OneWay}" ToolTipService.ToolTip="Volume">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="240" Spacing="8" Padding="4">
                                <Grid>
                                    <TextBlock Text="Volume" FontWeight="SemiBold" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                               Text="{x:Bind Model.VolumePercent, Mode=OneWay}" />
                                </Grid>
                                <!-- 0 to 100 in whole steps. On 0 to 1 the default step of 1 let
                                     the thumb sit only at the two ends. -->
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind Model.VolumePercent, Mode=OneWay}"
                                        ValueChanged="OnVolumeChanged"
                                        AutomationProperties.Name="Volume" />
                                <Button Content="{x:Bind Model.MuteLabel, Mode=OneWay}"
                                        HorizontalAlignment="Stretch" Click="OnToggleMuted" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="LyricsButton" Style="{StaticResource TransportToggleStyle}"
                              Content="&#xE90A;" ToolTipService.ToolTip="Lyrics"
                              Click="OnToggleLyrics" />
                <ToggleButton x:Name="QueueButton" Style="{StaticResource TransportToggleStyle}"
                              Content="&#xE8FD;" ToolTipService.ToolTip="Playing Next"
                              Click="OnToggleQueue" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The always-present icon rail. The named sidebar opens over the content. -->
            <Border Grid.Column="0" Background="{ThemeResource GoosicRailBrush}">
                <Grid>
                    <StackPanel Orientation="Vertical" Spacing="4" Margin="0,8,0,0">
                        <Button Style="{StaticResource RailGlyphStyle}" Content="&#xE72B;"
                                ToolTipService.ToolTip="Back" Click="OnBack" />
                        <Button Style="{StaticResource RailGlyphStyle}" Content="&#xE700;"
                                ToolTipService.ToolTip="Menu" Click="OnToggleSidebar" />
                        <Button Style="{StaticResource RailGlyphStyle}" Content="&#xE721;"
                                ToolTipService.ToolTip="Search" Click="OnSearchRoute" />
                        <ItemsControl x:Name="RailRoutes" ItemsSource="{x:Bind Model.Routes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteEntry">
                                    <Button Style="{StaticResource RailRouteStyle}"
                                            Content="{x:Bind Glyph}"
                                            ToolTipService.ToolTip="{x:Bind Title}"
                                            Tag="{x:Bind Route}"
                                            Click="OnRailRoute" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button x:Name="AccountButton" Style="{StaticResource RailAvatarStyle}"
                            VerticalAlignment="Bottom" Margin="0,0,0,10"
                            Content="{x:Bind Model.AccountInitials, Mode=OneWay}"
                            Click="OnAccount">
                        <Button.Flyout>
                            <Flyout x:Name="AccountFlyout" Placement="RightEdgeAlignedBottom">
                                <StackPanel Width="300" Spacing="4">
                                    <Grid ColumnSpacing="12" Margin="4,4,4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{StaticResource GoosicAccentBrush}">
                                            <TextBlock Text="{x:Bind Model.AccountInitials, Mode=OneWay}"
                                                       Foreground="White" FontWeight="SemiBold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Model.AccountName, Mode=OneWay}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Model.AccountDetail, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                                       TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                            Visibility="{x:Bind Model.IsGuest, Mode=OneWay}" Click="OnSignIn">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                            <TextBlock Text="Sign in with Google" />
                                        </StackPanel>
                                    </Button>

                                    <MenuFlyoutSeparator Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" />
                                    <Button Style="{StaticResource SidebarRouteStyle}" Tag="library"
                                            Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" Click="OnAccountRoute">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="15" />
                                            <TextBlock Text="Your library" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SidebarRouteStyle}" Tag="liked"
                                            Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" Click="OnAccountRoute">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8E1;" FontSize="15" />
                                            <TextBlock Text="Liked music" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SidebarRouteStyle}" Tag="history"
                                            Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" Click="OnAccountRoute">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE81C;" FontSize="15" />
                                            <TextBlock Text="History" />
                                        </StackPanel>
                                    </Button>

                                    <MenuFlyoutSeparator />
                                    <TextBlock Text="Accounts" FontSize="12" Margin="8,4,0,0"
                                               Foreground="{ThemeResource GoosicSecondaryTextBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind Model.Accounts, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AccountViewModel">
                                                <Button Style="{StaticResource SidebarRouteStyle}" Tag="{x:Bind Tag}"
                                                        Click="OnUseAccount">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="26" Height="26" CornerRadius="13"
                                                                Background="{ThemeResource GoosicRaisedStrongBrush}">
                                                            <TextBlock Text="{x:Bind Initial}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Detail}" FontSize="11"
                                                                       Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <FontIcon Grid.Column="2" Glyph="{x:Bind ActiveMarker}" FontSize="12" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource SidebarRouteStyle}"
                                            Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" Click="OnUseGuest">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE7EE;" FontSize="15" />
                                            <TextBlock Text="Browse as a guest" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SidebarRouteStyle}"
                                            Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" Click="OnSignIn">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8FA;" FontSize="15" />
                                            <TextBlock Text="Add another account" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SidebarRouteStyle}"
                                            Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}" Click="OnSignOut">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF3B1;" FontSize="15" />
                                            <TextBlock Text="Sign out" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- Content. -->
            <ScrollViewer Grid.Column="1" Padding="26,18,26,24" x:Name="ContentScroller">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Model.PageTitle, Mode=OneWay}"
                                   FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind Model.PageSubtitle, Mode=OneWay}"
                                   FontSize="13" Foreground="{ThemeResource GoosicSecondaryTextBrush}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind Model.LibrarySections}"
                                      Visibility="{x:Bind Model.IsLibraryPage, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibrarySection">
                                    <Button Content="{x:Bind Title}" CornerRadius="8" Padding="12,5"
                                            Click="OnLibrarySection" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnPlayPage"
                                    Visibility="{x:Bind Model.HasTracks, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnShufflePage" Visibility="{x:Bind Model.HasTracks, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                            <Button Visibility="{x:Bind Model.CanSavePagePlaylist, Mode=OneWay}" Click="OnSavePagePlaylist">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                    <TextBlock Text="Save to library" />
                                </StackPanel>
                            </Button>
                            <Button Visibility="{x:Bind Model.CanFollowPageArtist, Mode=OneWay}" Click="OnFollowPageArtist">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                                    <TextBlock Text="Subscribe" />
                                </StackPanel>
                            </Button>
                            <Button Visibility="{x:Bind Model.IsOwnedPlaylistPage, Mode=OneWay}"
                                    ToolTipService.ToolTip="Edit playlist">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Rename…" Click="OnRenamePagePlaylist">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSubItem Text="Who can see this">
                                            <MenuFlyoutItem Text="Public" Tag="PUBLIC" Click="OnPagePlaylistPrivacy" />
                                            <MenuFlyoutItem Text="Unlisted" Tag="UNLISTED" Click="OnPagePlaylistPrivacy" />
                                            <MenuFlyoutItem Text="Private" Tag="PRIVATE" Click="OnPagePlaylistPrivacy" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete playlist…" Click="OnDeletePagePlaylist">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <InfoBar x:Name="StatusBar" IsOpen="{x:Bind Model.HasStatus, Mode=OneWay}"
                             Message="{x:Bind Model.Status, Mode=OneWay}" IsClosable="False"
                             Severity="Informational" />

                    <!-- Track rows: search results, and ordered lists on a detail page. -->
                    <ItemsControl ItemsSource="{x:Bind Model.Tracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackViewModel">
                                <Button Style="{StaticResource TrackRowStyle}" Tag="{x:Bind VideoIdOrEmpty}"
                                        Click="OnPlayTrack" ContextRequested="OnItemContextRequested">
                                    <Grid ColumnSpacing="11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                                Background="{ThemeResource GoosicRaisedBrush}">
                                            <Image Source="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                       Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Duration}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource GoosicSecondaryTextBrush}" />
                                        <Button Grid.Column="3" Style="{StaticResource TransportGlyphStyle}"
                                                Content="&#xE712;" ToolTipService.ToolTip="More"
                                                AutomationProperties.Name="More options"
                                                Click="OnItemMore" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{x:Bind Model.Shelves, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShelfViewModel">
                                <StackPanel Spacing="10" Margin="0,0,0,22">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Title}" FontSize="19" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                            <Button Style="{StaticResource ShelfArrowStyle}" Content="&#xE76B;"
                                                    ToolTipService.ToolTip="Scroll left" Tag="-1"
                                                    Click="OnShelfScroll" />
                                            <Button Style="{StaticResource ShelfArrowStyle}" Content="&#xE76C;"
                                                    ToolTipService.ToolTip="Scroll right" Tag="1"
                                                    Click="OnShelfScroll" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer HorizontalScrollMode="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Disabled"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{x:Bind Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CardViewModel">
                                                  <Button Style="{StaticResource CardButtonStyle}"
                                                          Tag="{x:Bind ActivationTag}" Click="OnCardActivated"
                                                          ContextRequested="OnItemContextRequested">
                                                    <StackPanel Width="{StaticResource GoosicCardSize}" Spacing="7">
                                                        <Border Width="{StaticResource GoosicCardSize}"
                                                                Height="{StaticResource GoosicCardSize}"
                                                                CornerRadius="9"
                                                                Background="{ThemeResource GoosicRaisedBrush}">
                                                            <Image Source="{x:Bind Artwork, Mode=OneWay}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Title}" FontSize="14"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                                   Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                  </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button HorizontalAlignment="Center" Content="Load more"
                            Visibility="{x:Bind Model.HasMore, Mode=OneWay}" Click="OnLoadMore" />
                </StackPanel>
            </ScrollViewer>

            <!-- Lyrics and Playing Next share this edge, as they do on macOS: one at a time. -->
            <Border x:Name="SidePanel" Grid.Column="2" Width="352" Visibility="Collapsed"
                    Background="{ThemeResource GoosicChromeBrush}"
                    BorderThickness="1,0,0,0" BorderBrush="{ThemeResource GoosicHairlineBrush}">
                <Grid Margin="16">
                    <TextBlock x:Name="SidePanelMessage" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                               Text="Nothing playing." TextWrapping="Wrap" />
                    <Grid x:Name="QueuePanel" Visibility="Collapsed" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="1">
                                <TextBlock Text="Playing Next" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind Model.QueueSummary, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource GoosicSecondaryTextBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Clear"
                                    Visibility="{x:Bind Model.HasQueue, Mode=OneWay}" Click="OnClearQueue" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QueueItems" ItemsSource="{x:Bind Model.Queue, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrackViewModel">
                                        <Button Style="{StaticResource TrackRowStyle}" Tag="{x:Bind VideoIdOrEmpty}"
                                                Click="OnPlayTrack" ContextRequested="OnItemContextRequested">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="4"
                                                        Background="{ThemeResource GoosicRaisedBrush}">
                                                    <Grid>
                                                        <Image Source="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                                                        <Border Background="#99000000"
                                                                Visibility="{x:Bind CurrentMarker, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE995;" FontSize="16" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                               Foreground="{ThemeResource GoosicSecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource TransportGlyphStyle}"
                                                        Content="&#xE711;" ToolTipService.ToolTip="Remove from queue"
                                                        AutomationProperties.Name="Remove from queue"
                                                        Click="OnRemoveFromQueue" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="LyricsItems" Visibility="Collapsed"
                                      ItemsSource="{x:Bind Model.Lyrics, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LyricLineViewModel">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="20"
                                               FontWeight="SemiBold" Margin="0,0,0,16"
                                               Opacity="{x:Bind Emphasis, Mode=OneWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--
            The official player.

            One pixel and kept mounted for the lifetime of the window, so there is one renderer
            and one WebView2 profile however many tracks are played. It is a renderer, never a
            surface the user browses: what it is showing is reported, not displayed.
        -->
<Grid x:Name="WebHost" Grid.Row="1" Width="1" Height="1"
              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

        <!--
            The named sidebar. It is drawn over the content rather than beside it, the way Apple
            Music's is, so opening it does not reflow the shelves underneath.
        -->
        <Grid x:Name="SidebarOverlay" Grid.Row="1" Visibility="Collapsed">
            <Rectangle Fill="#80000000" Tapped="OnDismissSidebar" />
            <Border Width="{StaticResource GoosicSidebarWidth}" HorizontalAlignment="Left"
                    Background="{ThemeResource GoosicRailBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{ThemeResource GoosicHairlineBrush}">
                <StackPanel Margin="12,10,12,12" Spacing="6">
                    <AutoSuggestBox x:Name="SidebarSearch" PlaceholderText="Search"
                                    QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" />
                    <ItemsControl ItemsSource="{x:Bind Model.Routes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteEntry">
                                <Button Style="{StaticResource SidebarRouteStyle}"
                                        Tag="{x:Bind Route}" Click="OnSidebarRoute">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Glyph}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15" Width="18" />
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="6" Visibility="{x:Bind Model.IsSignedIn, Mode=OneWay}">
                        <MenuFlyoutSeparator />
                        <Button HorizontalAlignment="Stretch" CornerRadius="16" Click="OnNewPlaylist">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="New playlist" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind Model.UserPlaylists, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaylistSummaryViewModel">
                                        <Button Style="{StaticResource SidebarRouteStyle}" Padding="10,5"
                                                Tag="{x:Bind ActivationTag}" Click="OnSidebarPlaylist">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource GoosicSecondaryTextBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
