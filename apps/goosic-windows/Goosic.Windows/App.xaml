<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Goosic.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Palette.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Sliders fill in the neutral accent (Styles/Palette.xaml) and carry a white thumb. -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EEEEEE" />
            <!-- Menu rows under the pointer keep WinUI's own neutral fill: Goosic has no colour accent. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
