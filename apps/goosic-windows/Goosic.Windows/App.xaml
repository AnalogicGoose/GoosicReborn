<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Goosic.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Palette.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Sliders fill in the brand red and carry a white thumb, as the volume popover shows. -->
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="GoosicAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="GoosicAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="GoosicAccentBrush" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EEEEEE" />
            <!-- A menu row under the pointer fills with the brand colour and turns white, as a
                 macOS menu's selection does with the accent colour. -->
            <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="GoosicAccentBrush" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="GoosicAccentBrush" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="White" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundPointerOver" ResourceKey="GoosicAccentBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundPressed" ResourceKey="GoosicAccentBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" ResourceKey="GoosicAccentBrush" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" Color="White" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="White" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="White" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
